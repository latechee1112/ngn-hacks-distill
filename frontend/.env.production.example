# Copy to .env.production and fill in your deployed backend's URL before running
# `npm run build` to produce a demo package for people who won't run the backend
# themselves (e.g. judges installing the zipped extension). Vite loads this file
# automatically for production builds; leave it absent for local dev, which falls
# back to http://127.0.0.1:8000 (see src/background/background.ts).
VITE_BACKEND_URL=https://your-deployed-backend.example.com
